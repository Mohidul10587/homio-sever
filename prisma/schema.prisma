generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  DOCTOR
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

enum FollowUpStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  phone        String   @unique
  passwordHash String
  role         UserRole @default(DOCTOR)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  doctorProfile DoctorProfile?
  patients      Patient[]
  subscription  Subscription?
  auditLogs     AuditLog[]
  usageRecords  UsageRecord[]
}

model DoctorProfile {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String  @unique @db.Uuid
  user        User    @relation(fields: [userId], references: [id])
  clinicName  String?
  address     String?
  specialization String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Patient {
  id          String   @id @default(uuid()) @db.Uuid
  doctorId    String   @db.Uuid
  doctor      User     @relation(fields: [doctorId], references: [id])
  name        String
  phone       String?
  age         Int?
  gender      String?
  address     String?
  dateOfBirth DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  visits    PatientVisit[]
  followUps FollowUp[]

  @@index([doctorId])
}

model PatientVisit {
  id          String    @id @default(uuid()) @db.Uuid
  patientId   String    @db.Uuid
  patient     Patient   @relation(fields: [patientId], references: [id])
  visitNumber Int       @default(1)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  caseResponse CaseResponse?
  analysis     Analysis?
  followUp     FollowUp?

  @@index([patientId])
}

model CaseResponse {
  id              String      @id @default(uuid()) @db.Uuid
  visitId         String      @unique @db.Uuid
  visit           PatientVisit @relation(fields: [visitId], references: [id])
  
  mainDisease     String
  duration        String?
  onset           String?
  
  aggravation     String[]
  amelioration    String[]
  
  mentalState     String[]
  thermalState    String?
  thirst          String[]
  foodPreference  String[]
  sleep           String[]
  
  additionalSymptoms String?
  rawFormData     Json?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Analysis {
  id          String        @id @default(uuid()) @db.Uuid
  visitId     String        @unique @db.Uuid
  visit       PatientVisit  @relation(fields: [visitId], references: [id])
  status      AnalysisStatus @default(PENDING)
  
  caseSummary String?
  
  promptVersion String?
  aiProvider    String?
  modelUsed     String?
  processingTime Int?
  
  doctorDecision     String?
  doctorNotes        String?
  prescriptionNotes  String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  step1     AnalysisStep1?
  step2     AnalysisStep2?
  step3     AnalysisStep3?
}

model AnalysisStep1 {
  id                   String   @id @default(uuid()) @db.Uuid
  analysisId           String   @unique @db.Uuid
  analysis             Analysis @relation(fields: [analysisId], references: [id])
  
  importantSymptoms    Json
  uniqueSymptoms       Json
  characteristicSymptoms Json
  peculiarSymptoms     Json
  symptomPriority      Json
  
  rawAiResponse        Json?
  
  createdAt            DateTime @default(now())
}

model AnalysisStep2 {
  id          String   @id @default(uuid()) @db.Uuid
  analysisId  String   @unique @db.Uuid
  analysis    Analysis @relation(fields: [analysisId], references: [id])
  
  mainDisease String
  remedies    Json
  
  rawAiResponse Json?
  
  createdAt   DateTime @default(now())
}

model AnalysisStep3 {
  id          String   @id @default(uuid()) @db.Uuid
  analysisId  String   @unique @db.Uuid
  analysis    Analysis @relation(fields: [analysisId], references: [id])
  
  top3        Json
  
  rawAiResponse Json?
  
  createdAt   DateTime @default(now())
}

model FollowUp {
  id              String        @id @default(uuid()) @db.Uuid
  patientId       String        @db.Uuid
  patient         Patient       @relation(fields: [patientId], references: [id])
  visitId         String?       @unique @db.Uuid
  visit           PatientVisit? @relation(fields: [visitId], references: [id])
  
  status          FollowUpStatus @default(SCHEDULED)
  scheduledDate   DateTime?
  
  currentSymptoms String?
  improvementPercent Int?
  newSymptoms     String?
  worseSymptoms   String?
  betterSymptoms  String?
  sleepChange     String?
  appetiteChange  String?
  energyChange    String?
  newModalities   String?
  medicineResponse String?
  doctorNotes     String?
  
  aiComparison    Json?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([patientId])
}

model Plan {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  price       Float
  durationDays Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @unique @db.Uuid
  user        User               @relation(fields: [userId], references: [id])
  planId      String?            @db.Uuid
  plan        Plan?              @relation(fields: [planId], references: [id])
  status      SubscriptionStatus @default(TRIAL)
  trialEndsAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model UsageRecord {
  id             String   @id @default(uuid()) @db.Uuid
  doctorId       String   @db.Uuid
  doctor         User     @relation(fields: [doctorId], references: [id])
  patientId      String?
  visitId        String?
  analysisId     String?
  aiProvider     String?
  modelUsed      String?
  tokenUsage     Int?
  cost           Float?
  processingTime Int?
  status         String?
  error          String?
  createdAt      DateTime @default(now())

  @@index([doctorId])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String?
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([userId])
}
